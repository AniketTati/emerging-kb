# UI -> API configuration.  Copy this to .env.local before `npm run dev`:
#
#     cp .env.local.example .env.local
#
# (scripts/bootstrap.sh does this for you.)

# Which workspace the single-tenant UI displays (no login — one workspace at a
# time). The seed ships a fully-extracted FINANCE workspace (55 docs across
# markdown, email, digital PDF, scanned/OCR PDF, and spreadsheets) as the
# default demo. Switch to c0000000-0000-0000-0000-000000000001 to view the
# construction corpus instead.
NEXT_PUBLIC_KB_WORKSPACE_ID=f0000000-0000-0000-0000-000000000001

# Where the browser reaches the API. docker compose publishes the API on :8000.
NEXT_PUBLIC_KB_API_URL=http://localhost:8000
