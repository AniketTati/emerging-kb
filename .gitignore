docs/Build a Knowledge Base Service.pdf

# Prototype QA artifacts — regenerable, don't bloat the repo
prototype/node_modules/
prototype/package-lock.json
prototype/qa/screens/
prototype/qa/reports/

# demo-corpus/domains, workspaces, entities.yaml, validate.py are NOW tracked:
# they hold the 6-domain corpus + the verified eval set (queries.yaml, 93%
# corpus-grounded) + manifests — the canonical eval, and an assignment
# deliverable. Only genuine ingest/validation scratch should be ignored below.
demo-corpus/**/*.bak
demo-corpus/**/*.bak[0-9]

# M1 stage-eval transient run outputs (baselines are snapshotted under docs/eval_baselines/)
eval_out/

# Submission write-up (≤4-page doc + diagram). Kept out of git on purpose —
# the deliverable code/seed-data/schema/eval are committed; the write-up lives
# here, untracked.
submission/
